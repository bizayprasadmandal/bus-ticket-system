# Copy to frontend/.env.local for local dev (optional — defaults to /api via Vite proxy)

# Production (Render static site):
# VITE_API_URL=https://YOUR_API.onrender.com/api
# VITE_WS_URL=https://YOUR_API.onrender.com

# Local dev: leave unset to use Vite proxy (http://localhost:3000)
# VITE_API_URL=http://localhost:3000/api
# VITE_WS_URL=http://localhost:3000
